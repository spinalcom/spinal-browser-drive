{
  "name": "spinal-browser-drive",
  "version": "v3.0.0",
  "homepage": "https://github.com/spinalcom/spinal-browser-drive",
  "authors": [
    "laurent <l.hatamdan@spinalcom.com>"
  ],
  "description": "Utility to manage the SpinalCom FileSystem and more ...",
  "license": "SpinalCore",
  "private": true,
  "scripts": {
    "post:build:drive": "npm run copy:templates.drive && npm run copy:assets.drive && npm run rename:index.drive",
    "post:build:admin": "npm run copy:templates.admin && npm run copy:assets.admin && npm run rename:index.admin",
    "copy:templates.drive": "mkdir -p drive/app && cp -R src/templates drive/app/templates",
    "copy:templates.admin": "mkdir -p admin/app && cp -R src/templates admin/app/templates",
    "copy:assets.drive": "cp -R src/assets drive/assets",
    "copy:assets.admin": "cp -R src/assets admin/assets",
    "rename:index.drive": "mv drive/drive.html drive/index.html",
    "rename:index.admin": "mv admin/admin.html admin/index.html",
    "clean:drive": "rm -rf drive",
    "clean:admin": "rm -rf admin",
    "build:drive": "npm run clean:drive && parcel build src/drive.html --no-autoinstall --no-optimize --public-url '/html/drive/' --dist-dir drive/ --no-scope-hoist --no-content-hash && npm run post:build:drive",
    "build:admin": "npm run clean:admin && parcel build src/admin.html --no-autoinstall --no-optimize --public-url '/html/admin/' --dist-dir admin/ --no-scope-hoist --no-content-hash && npm run post:build:admin",
    "build": "echo use npm run build:drive , npm run build:admin or npm run build:all",
    "build:all": "npm run build:drive && npm run build:admin"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@parcel/packager-raw-url": "^2.3.2",
    "@parcel/packager-xml": "^2.16.4",
    "@parcel/transformer-typescript-tsc": "^2.3.2",
    "@parcel/transformer-webmanifest": "^2.3.2",
    "@parcel/transformer-xml": "^2.16.4",
    "aes-js": "^3.1.2",
    "angular": "^1.6.6",
    "angular-animate": "^1.6.10",
    "angular-aria": "^1.6.10",
    "angular-material": "^1.1.5",
    "angular-material-data-table": "^0.10.10",
    "angular-material-icons": "^0.7.1",
    "angular-moment": "^1.3.0",
    "angular-route": "^1.6.6",
    "bootstrap": "^3.3.7",
    "buffer": "^6.0.3",
    "d3": "^4.12.0",
    "d3-context-menu": "*",
    "events": "^3.3.0",
    "font-awesome": "^4.7.0",
    "golden-layout": "^1.5.9",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.12.1",
    "jstree": "^3.3.4",
    "lodash.throttle": "^4.1.1",
    "material-design-icons": "^3.0.1",
    "moment": "^2.24.0",
    "parcel": "^2.12.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "spinal-core-connectorjs": "git+https://github.com/spinalcom/spinal-core-connectorjs.git",
    "spinal-core-connectorjs_type": "github:spinalcom/spinal-core-connectorjs_type",
    "spinal-env-drive-core": "github:spinalcom/spinal-env-drive-core",
    "spinal-env-viewer-graph-service": "github:spinalcom/Spinal-Graph-Service",
    "spinal-model-file_version_model": "github:spinalcom/spinal-model-file_version_model",
    "spinal-model-graph": "github:spinalcom/spinal-model-graph"
  },
  "resolutions": {
    "jquery": "^3.7.1",
    "d3": "^4.12.0"
  }
}